<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherImportRosterView"
             Title="TeacherImportRosterView">
	<ScrollView>
		<VerticalStackLayout>
			<Label Text="Import Roster from CSV" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
			<Label x:Name="CourseNameLabel" VerticalOptions="Center" HorizontalOptions="Center"/>

			<Label Text="CSV File Path:"/>
			<Entry x:Name="FilePathEntry" Placeholder="C:\path\to\roster.csv"/>

			<Label Text="CSV Format:"/>
			<Label Text="StudentCode,Name,Classification"/>
			<Label Text="S1001,Alice Johnson,Freshman"/>
			<Label Text="S1002,Bob Smith,Sophomore"/>

			<Label Text="Note: Import is idempotent - only NEW students will be added."/>
			<Label Text="Existing students will not be duplicated."/>

			<Button Text="Import Roster" Clicked="OnImportClicked"/>
			<Button Text="Cancel" Clicked="OnCancelClicked"/>

			<Label x:Name="ResultLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>