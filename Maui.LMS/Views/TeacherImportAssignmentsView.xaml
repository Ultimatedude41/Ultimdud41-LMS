<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherImportAssignmentsView"
             Title="TeacherImportAssignmentsView">
	<ScrollView>
		<VerticalStackLayout>
			<Label Text="Import Assignments from CSV" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
			<Label x:Name="CourseNameLabel" VerticalOptions="Center" HorizontalOptions="Center"/>

			<Label Text="CSV File Path:"/>
			<Entry x:Name="FilePathEntry" Placeholder="C:\path\to\assignments.csv"/>

			<Label Text="CSV Format:"/>
			<Label Text="AssignmentName,Description,AvailablePoints,DueDate"/>
			<Label Text="Homework 1,Complete exercises 1-10,100,2026-01-15"/>
			<Label Text="Quiz 1,Chapter 1 quiz,50,2026-01-20"/>

			<Label Text="Note: Import is idempotent - only NEW assignments will be added."/>
			<Label Text="Existing assignments (by name) will not be duplicated."/>

			<Button Text="Import Assignments" Clicked="OnImportClicked"/>
			<Button Text="Cancel" Clicked="OnCancelClicked"/>

			<Label x:Name="ResultLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>