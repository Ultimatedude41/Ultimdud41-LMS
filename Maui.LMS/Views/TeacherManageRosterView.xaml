<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherManageRosterView"
             Title="TeacherManageRosterView">
	<ScrollView>
		<VerticalStackLayout>
			<Label x:Name="CourseNameLabel" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>

			<Label Text="Students in Course" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>
			<Label x:Name="NoEnrolledLabel" Text="No students enrolled yet" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
			<ListView x:Name="EnrolledListView" ItemsSource="{Binding EnrolledStudents}">
				<ListView.ItemTemplate>
					<DataTemplate>
						<ViewCell>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Label Grid.Column="0" Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
								<Button Grid.Column="1" Text="Remove" Clicked="OnRemoveStudentClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
							</Grid>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<Label Text="Available Students" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>
			<Label x:Name="NoAvailableLabel" Text="All students are enrolled" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
			<ListView x:Name="AvailableListView" ItemsSource="{Binding AvailableStudents}">
				<ListView.ItemTemplate>
					<DataTemplate>
						<ViewCell>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Label Grid.Column="0" Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
								<Button Grid.Column="1" Text="Add" Clicked="OnAddStudentClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
							</Grid>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<Button Text="Go Back" Clicked="GoBackClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>