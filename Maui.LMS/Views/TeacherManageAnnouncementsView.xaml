<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherManageAnnouncementsView"
             Title="TeacherManageAnnouncementsView">
	<VerticalStackLayout>
		<Label x:Name="CourseNameLabel" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
		<Label Text="Announcements" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>
		<Label x:Name="EmptyStateLabel" Text="No announcements in this course." VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
		<ListView x:Name="AnnouncementListView" ItemsSource="{Binding Announcements}">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Label Grid.Column="0" Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
							<Button Grid.Column="1" Text="Edit" Clicked="OnEditClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
							<Button Grid.Column="2" Text="Delete" Clicked="OnDeleteClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
		<Button Text="Add New Announcement" Clicked="OnAddAnnouncementClicked"/>
		<Button Text="Go Back" Clicked="GoBackClicked"/>
	</VerticalStackLayout>
</ContentPage>