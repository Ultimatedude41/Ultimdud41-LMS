<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherEditCourseView"
             Title="TeacherEditCourseView">
	<ScrollView>
		<VerticalStackLayout>
			<Label Text="Edit Course" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>

			<Label Text="Course Code:"/>
			<Entry x:Name="CodeEntry" Placeholder="e.g., CS101"/>

			<Label Text="Course Name:"/>
			<Entry x:Name="NameEntry" Placeholder="e.g., Introduction to Programming"/>

			<Label Text="Section:"/>
			<Entry x:Name="SectionEntry" Placeholder="e.g., A"/>

			<Label Text="Description:"/>
			<Editor x:Name="DescriptionEditor" Placeholder="Enter course description" HeightRequest="100"/>

			<Label Text="Semester:"/>
			<Entry x:Name="SemesterEntry" Placeholder="e.g., Fall 2025"/>

			<Button Text="Save Changes" Clicked="OnSaveChangesClicked"/>
			<Button Text="Cancel" Clicked="OnCancelClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>