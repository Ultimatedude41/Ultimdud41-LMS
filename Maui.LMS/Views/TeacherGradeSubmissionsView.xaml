<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherGradeSubmissionsView"
             Title="TeacherGradeSubmissionsView">
	<ScrollView>
		<VerticalStackLayout>
			<Label x:Name="AssignmentNameLabel" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
			<Label Text="Submissions" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>
			<Label x:Name="EmptyStateLabel" Text="No submissions for this assignment." VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
			<VerticalStackLayout x:Name="SubmissionsContainer"/>
			<Button Text="Go Back" Clicked="GoBackClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>