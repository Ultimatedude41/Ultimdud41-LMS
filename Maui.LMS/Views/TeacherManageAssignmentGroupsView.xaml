<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherManageAssignmentGroupsView"
             Title="TeacherManageAssignmentGroupsView">
	<ScrollView>
		<VerticalStackLayout>
			<Label x:Name="CourseNameLabel" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
			<Label Text="Assignment Groups" VerticalOptions="Center" HorizontalOptions="Center" FontSize="16"/>
			<Label x:Name="EmptyStateLabel" Text="No assignment groups in this course." VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
			<VerticalStackLayout x:Name="GroupsContainer"/>
			<Button Text="Add New Assignment Group" Clicked="OnAddGroupClicked"/>
			<Button Text="Go Back" Clicked="GoBackClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>