<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherAddStudentView"
             Title="TeacherAddStudentView">
	<ScrollView>
		<VerticalStackLayout>
			<Label Text="Add New Student" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>

			<Label Text="Student Code:"/>
			<Entry x:Name="CodeEntry" Placeholder="e.g., S1005"/>

			<Label Text="Name:"/>
			<Entry x:Name="NameEntry" Placeholder="Enter full name (e.g., Alice Johnson)"/>

			<Label Text="Classification:"/>
			<Picker x:Name="ClassificationPicker">
				<Picker.Items>
					<x:String>Freshman</x:String>
					<x:String>Sophomore</x:String>
					<x:String>Junior</x:String>
					<x:String>Senior</x:String>
				</Picker.Items>
			</Picker>

			<Button Text="Add Student" Clicked="OnAddStudentClicked"/>
			<Button Text="Cancel" Clicked="OnCancelClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>