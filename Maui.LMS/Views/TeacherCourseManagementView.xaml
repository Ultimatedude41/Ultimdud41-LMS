<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherCourseManagementView"
             Title="TeacherCourseManagementView">
	<VerticalStackLayout>
		<Label Text="Course Management" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
		<Label x:Name="EmptyStateLabel" Text="No courses available." VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
		<ListView x:Name="CourseListView" ItemsSource="{Binding Courses}">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Label Grid.Column="0" Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
							<Button Grid.Column="1" Text="Select" Clicked="OnSelectClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
							<Button Grid.Column="2" Text="Edit" Clicked="OnEditClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
							<Button Grid.Column="3" Text="Copy" Clicked="OnCopyClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
							<Button Grid.Column="4" Text="Delete" Clicked="OnDeleteClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
		<Button Text="Add New Course" Clicked="OnAddCourseClicked"/>
		<Button Text="Go Back" Clicked="GoBackClicked"/>
	</VerticalStackLayout>
</ContentPage>