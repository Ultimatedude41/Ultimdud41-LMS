<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherAddAssignmentView"
             Title="TeacherAddAssignmentView">
	<ScrollView>
		<VerticalStackLayout>
			<Label Text="Add New Assignment" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>

			<Label Text="Type:"/>
			<Picker x:Name="TypePicker" SelectedIndexChanged="OnTypeChanged">
				<Picker.Items>
					<x:String>Assignment</x:String>
					<x:String>Quiz</x:String>
				</Picker.Items>
			</Picker>

			<Label Text="Assignment Name:"/>
			<Entry x:Name="NameEntry" Placeholder="Enter assignment name"/>

			<!-- Assignment Description (only for regular assignments) -->
			<StackLayout x:Name="DescriptionSection" IsVisible="False">
				<Label Text="Description:"/>
				<Editor x:Name="DescriptionEditor" Placeholder="Enter description" HeightRequest="100"/>
			</StackLayout>

			<!-- Quiz Question (only for quizzes) -->
			<StackLayout x:Name="QuestionSection" IsVisible="False">
				<Label Text="Question:"/>
				<Editor x:Name="QuestionEditor" Placeholder="Enter quiz question" HeightRequest="100"/>
			</StackLayout>

			<Label Text="Available Points:"/>
			<Entry x:Name="PointsEntry" Placeholder="e.g., 100" Keyboard="Numeric"/>

			<Label Text="Due Date (YYYY-MM-DD):"/>
			<Entry x:Name="DueDateEntry" Placeholder="e.g., 2025-12-31"/>

			<Button Text="Add Assignment" Clicked="OnAddAssignmentClicked"/>
			<Button Text="Cancel" Clicked="OnCancelClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>