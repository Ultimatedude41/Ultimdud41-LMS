<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherAddAssignmentToGroupView"
             Title="TeacherAddAssignmentToGroupView">
	<VerticalStackLayout>
		<Label x:Name="GroupNameLabel" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
		<Label Text="Select Assignment to Add:" VerticalOptions="Center" HorizontalOptions="Center"/>
		<Label x:Name="EmptyStateLabel" Text="No available assignments to add." VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False"/>
		<ListView x:Name="AssignmentListView" ItemsSource="{Binding AvailableAssignments}">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Label Grid.Column="0" Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
							<Button Grid.Column="1" Text="Add" Clicked="OnAddClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
		<Button Text="Cancel" Clicked="OnCancelClicked"/>
	</VerticalStackLayout>
</ContentPage>