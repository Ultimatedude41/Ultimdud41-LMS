<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherCopyCourseView"
             Title="TeacherCopyCourseView">
	<ScrollView>
		<VerticalStackLayout>
			<Label Text="Copy Course" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
			<Label x:Name="OriginalCourseLabel" VerticalOptions="Center" HorizontalOptions="Center"/>

			<Label Text="New Section:"/>
			<Entry x:Name="SectionEntry" Placeholder="e.g., B"/>

			<Label Text="New Semester:"/>
			<Entry x:Name="SemesterEntry" Placeholder="e.g., Spring 2026"/>

			<Label Text="This will copy:"/>
			<Label Text="✓ Course structure (code, name, description)"/>
			<Label Text="✓ All assignments (without submissions)"/>
			<Label Text="✓ All modules and content"/>
			<Label Text="✗ Student roster (starts empty)"/>

			<Button Text="Copy Course" Clicked="OnCopyCourseClicked"/>
			<Button Text="Cancel" Clicked="OnCancelClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>