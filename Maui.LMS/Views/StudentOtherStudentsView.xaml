<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.StudentOtherStudentsView"
             Title="StudentOtherStudentsView">
	<VerticalStackLayout>
		<Label Text="Other Students in Course" VerticalOptions="Center" HorizontalOptions="Center"/>
		<CollectionView x:Name="StudentList">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Label Text="{Binding Name}" HorizontalTextAlignment="Center"/>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<Button Text="Go Back" Clicked="GoBackClicked"/>
	</VerticalStackLayout>
</ContentPage>