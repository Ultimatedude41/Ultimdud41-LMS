<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.StudentGradeDetailView"
             Title="StudentGradeDetailView">
	<ScrollView>
		<VerticalStackLayout>
			<Label x:Name="AssignmentNameLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
			<Label x:Name="GradeLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
			<Label x:Name="SubmissionDateLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
			<Label x:Name="FeedbackLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
			<Label Text="Your Submission:" VerticalOptions="Center" HorizontalOptions="Center"/>
			<Label x:Name="SubmissionContentLabel" VerticalOptions="Center" HorizontalOptions="Center"/>

			<!-- File submission -->
			<StackLayout x:Name="FileSection" IsVisible="False">
				<Label Text="File Submission:"/>
				<Label x:Name="FilePathLabel"/>
				<Label x:Name="FileContentLabel" IsVisible="False"/>
				<Button x:Name="OpenFileButton" Text="Open File" Clicked="OnOpenFileClicked"/>
			</StackLayout>

			<Button Text="Go Back" Clicked="GoBackClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>