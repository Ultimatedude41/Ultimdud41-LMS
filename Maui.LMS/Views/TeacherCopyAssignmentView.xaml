<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.TeacherCopyAssignmentView"
             Title="TeacherCopyAssignmentView">
	<VerticalStackLayout>
		<Label Text="Copy Assignment from Another Course" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>

		<Label Text="Select Source Course:"/>
		<ListView x:Name="CourseListView" ItemsSource="{Binding OtherCourses}" ItemSelected="OnCourseSelected">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Label Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<Label x:Name="AssignmentSectionLabel" Text="Select Assignment to Copy:" IsVisible="False"/>
		<ListView x:Name="AssignmentListView" IsVisible="False">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Label Grid.Column="0" Text="{Binding .}" VerticalOptions="Center" HorizontalOptions="Start"/>
							<Button Grid.Column="1" Text="Copy" Clicked="OnCopyClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<Button Text="Cancel" Clicked="OnCancelClicked"/>
	</VerticalStackLayout>
</ContentPage>