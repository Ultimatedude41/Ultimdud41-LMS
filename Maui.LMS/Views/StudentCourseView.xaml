<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.LMS.Views.StudentCourseView"
             Title="StudentCourseView">
	<VerticalStackLayout>
		<Label x:Name="StudentNameLabel" VerticalOptions="Center" HorizontalOptions="Center"/>
		<Label Text="Enrolled Courses" VerticalOptions="Center" HorizontalOptions="Center"/>
		<ListView ItemsSource="{Binding EnrolledCourses}">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Label Grid.Column="0" Text="{Binding Display}" VerticalOptions="Center" HorizontalOptions="Start"/>
							<Button Grid.Column="1" Text="Select" Clicked="OnCourseClicked" CommandParameter="{Binding}" VerticalOptions="Center" HorizontalOptions="End"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
		<Button Text="Go Back" Clicked="GoBackClicked"/>
	</VerticalStackLayout>
</ContentPage>